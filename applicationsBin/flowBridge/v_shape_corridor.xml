        <block position="17,7,0" orientation="0"/>
        <block position="17,8,0" orientation="0"/>
        <block position="18,8,0" orientation="0"/>
        <block position="18,9,0" orientation="0"/>
        <block position="19,9,0" orientation="0"/>

        <!-- Target pad z=0 : x=19..22, y=10..13 (16 cells) -->
        <block position="19,10,0" color="#00CCCC" orientation="0"/>
        <block position="19,11,0" color="#00CCCC" orientation="0"/>
        <block position="19,12,0" color="#00CCCC" orientation="0"/>
        <block position="19,13,0" color="#00CCCC" orientation="0"/>
        <block position="20,10,0" color="#00CCCC" orientation="0"/>
        <block position="20,11,0" color="#00CCCC" orientation="0"/>
        <block position="20,12,0" color="#00CCCC" orientation="0"/>
        <block position="20,13,0" color="#00CCCC" orientation="0"/>
        <block position="21,10,0" color="#00CCCC" orientation="0"/>
