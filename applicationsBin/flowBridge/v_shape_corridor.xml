        <block position="22,13,0" color="#00CCCC" orientation="0"/>

        <!-- Source modules z=1 : x=1..4, y=10..13 (16 modules) -->
        <block position="1,10,1" color="#00CC00" orientation="0"/>
        <block position="1,11,1" color="#00CC00" orientation="0"/>
        <block position="1,12,1" color="#00CC00" orientation="0"/>
