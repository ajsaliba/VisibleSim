<?xml version="1.0" standalone="no" ?>
<!--
  Scenario: TWO NARROW PINCHES IN SERIES
  --------------------------------------
  Source pad → pinch #1 → middle pad → pinch #2 → target pad.
  Both pinches are single-cell-wide, two cells long, so every motion path
  source→target must cross both narrow bottlenecks.
    |sources|        = 12
    |targets|        = 12
    bottleneck width = 1  (two serial 2-cell pinches)
  Expected:  bridge cells discovered ≪ |sources|  ⇒  SOURCE_ONLY branch.
-->
<world gridSize="18,8,6" windowSize="1280,720">
    <camera target="90,40,0" thetaPhiDist="-35,30,240" fov="30" near="1.0" far="500.0"/>
    <spotlight target="90,40,0" thetaPhiDist="-35,45,240" fov="20"/>
    <blockList color="128,128,128" blockSize="10,10,10">
        <!-- Source pad z=0 : x=1..3, y=1..4 -->
        <block position="1,1,0" orientation="0"/>
        <block position="1,2,0" orientation="0"/>
        <block position="1,3,0" orientation="0"/>
        <block position="1,4,0" orientation="0"/>
        <block position="2,1,0" orientation="0"/>
        <block position="2,2,0" orientation="0"/>
        <block position="2,3,0" orientation="0"/>
        <block position="2,4,0" orientation="0"/>
        <block position="3,1,0" orientation="0"/>
        <block position="3,2,0" orientation="0"/>
        <block position="3,3,0" orientation="0"/>
        <block position="3,4,0" orientation="0"/>
        <!-- Pinch #1 z=0 : x=4..5, y=3 -->
        <block position="4,3,0" orientation="0"/>
        <block position="5,3,0" orientation="0"/>
        <!-- Middle pad z=0 : x=6..8, y=1..4 -->
        <block position="6,1,0" orientation="0"/>
        <block position="6,2,0" orientation="0"/>
        <block position="6,3,0" orientation="0"/>
        <block position="6,4,0" orientation="0"/>
        <block position="7,1,0" orientation="0"/>
        <block position="7,2,0" orientation="0"/>
        <block position="7,3,0" orientation="0"/>
        <block position="7,4,0" orientation="0"/>
        <block position="8,1,0" orientation="0"/>
        <block position="8,2,0" orientation="0"/>
        <block position="8,3,0" orientation="0"/>
        <block position="8,4,0" orientation="0"/>
        <!-- Pinch #2 z=0 : x=9..10, y=3 -->
        <block position="9,3,0"  orientation="0"/>
        <block position="10,3,0" orientation="0"/>
        <!-- Target pad z=0 : x=11..13, y=1..4 -->
        <block position="11,1,0" color="#00CCCC" orientation="0"/>
        <block position="11,2,0" color="#00CCCC" orientation="0"/>
        <block position="11,3,0" color="#00CCCC" orientation="0"/>
        <block position="11,4,0" color="#00CCCC" orientation="0"/>
        <block position="12,1,0" color="#00CCCC" orientation="0"/>
        <block position="12,2,0" color="#00CCCC" orientation="0"/>
        <block position="12,3,0" color="#00CCCC" orientation="0"/>
        <block position="12,4,0" color="#00CCCC" orientation="0"/>
        <block position="13,1,0" color="#00CCCC" orientation="0"/>
        <block position="13,2,0" color="#00CCCC" orientation="0"/>
        <block position="13,3,0" color="#00CCCC" orientation="0"/>
        <block position="13,4,0" color="#00CCCC" orientation="0"/>
        <!-- Source modules z=1 : x=1..3, y=1..4  (12 modules) -->
        <block position="1,1,1" color="#00CC00" orientation="0"/>
        <block position="1,2,1" color="#00CC00" orientation="0"/>
        <block position="1,3,1" color="#00CC00" orientation="0"/>
        <block position="1,4,1" color="#00CC00" orientation="0"/>
        <block position="2,1,1" color="#00CC00" orientation="0"/>
        <block position="2,2,1" color="#00CC00" orientation="0"/>
        <block position="2,3,1" color="#00CC00" orientation="0"/>
        <block position="2,4,1" color="#00CC00" orientation="0"/>
        <block position="3,1,1" color="#00CC00" orientation="0"/>
        <block position="3,2,1" color="#00CC00" orientation="0"/>
        <block position="3,3,1" color="#00CC00" orientation="0"/>
        <block position="3,4,1" color="#00CC00" orientation="0"/>
    </blockList>
    <movingBlocks>
        <block position="1,1,1" color="#00CC00" orientation="0"/>
        <block position="1,2,1" color="#00CC00" orientation="0"/>
        <block position="1,3,1" color="#00CC00" orientation="0"/>
        <block position="1,4,1" color="#00CC00" orientation="0"/>
        <block position="2,1,1" color="#00CC00" orientation="0"/>
        <block position="2,2,1" color="#00CC00" orientation="0"/>
        <block position="2,3,1" color="#00CC00" orientation="0"/>
        <block position="2,4,1" color="#00CC00" orientation="0"/>
        <block position="3,1,1" color="#00CC00" orientation="0"/>
        <block position="3,2,1" color="#00CC00" orientation="0"/>
        <block position="3,3,1" color="#00CC00" orientation="0"/>
        <block position="3,4,1" color="#00CC00" orientation="0"/>
    </movingBlocks>
    <targetList>
        <target format="grid">
            <cell position="11,1,1" color="0,200,200"/>
            <cell position="11,2,1" color="0,200,200"/>
            <cell position="11,3,1" color="0,200,200"/>
            <cell position="11,4,1" color="0,200,200"/>
            <cell position="12,1,1" color="0,200,200"/>
            <cell position="12,2,1" color="0,200,200"/>
            <cell position="12,3,1" color="0,200,200"/>
            <cell position="12,4,1" color="0,200,200"/>
            <cell position="13,1,1" color="0,200,200"/>
            <cell position="13,2,1" color="0,200,200"/>
            <cell position="13,3,1" color="0,200,200"/>
            <cell position="13,4,1" color="0,200,200"/>
        </target>
    </targetList>
</world>
