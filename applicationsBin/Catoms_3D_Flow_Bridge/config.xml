<?xml version="1.0" standalone="no" ?>
<!-- Catoms 3D Flow Bridge Configuration
     Initial: An L-shaped structure with surplus modules on the left arm.
     Target:  A rectangular block; surplus modules fill demand positions. -->
<world gridSize="12,12,4" windowSize="1280,720">
    <camera target="30,30,10" directionSpherical="-30,35,120" angle="45.0" near="1.0" far="600.0"/>

    <blockList color="128,128,128" blockSize="10,10,10">
        <!-- Bottom layer (z=0): 6x4 base -->
        <block position="2,2,0" orientation="0" color="0,200,0"/>
        <block position="3,2,0" orientation="0" color="0,200,0"/>
        <block position="4,2,0" orientation="0" color="0,200,0"/>
        <block position="5,2,0" orientation="0" color="0,200,0"/>
        <block position="6,2,0" orientation="0" color="0,200,0"/>
        <block position="7,2,0" orientation="0" color="0,200,0"/>
        <block position="2,3,0" orientation="0" color="0,200,0"/>
        <block position="3,3,0" orientation="0" color="0,200,0"/>
        <block position="4,3,0" orientation="0" color="0,200,0"/>
        <block position="5,3,0" orientation="0" color="0,200,0"/>
        <block position="6,3,0" orientation="0" color="0,200,0"/>
        <block position="7,3,0" orientation="0" color="0,200,0"/>
        <block position="2,4,0" orientation="0" color="0,200,0"/>
        <block position="3,4,0" orientation="0" color="0,200,0"/>
        <block position="4,4,0" orientation="0" color="0,200,0"/>
        <block position="5,4,0" orientation="0" color="0,200,0"/>
        <block position="6,4,0" orientation="0" color="0,200,0"/>
        <block position="7,4,0" orientation="0" color="0,200,0"/>
        <block position="2,5,0" orientation="0" color="0,200,0"/>
        <block position="3,5,0" orientation="0" color="0,200,0"/>
        <block position="4,5,0" orientation="0" color="0,200,0"/>
        <block position="5,5,0" orientation="0" color="0,200,0"/>
        <block position="6,5,0" orientation="0" color="0,200,0"/>
        <block position="7,5,0" orientation="0" color="0,200,0"/>

        <!-- Supply arm: extra modules extending left (surplus, not in target) -->
        <block position="1,2,0" orientation="0" color="200,0,0"/>
        <block position="1,3,0" orientation="0" color="200,0,0"/>
        <block position="1,4,0" orientation="0" color="200,0,0"/>
        <block position="1,5,0" orientation="0" color="200,0,0"/>
        <block position="0,2,0" orientation="0" color="200,0,0"/>
        <block position="0,3,0" orientation="0" color="200,0,0"/>
        <block position="0,4,0" orientation="0" color="200,0,0"/>
        <block position="0,5,0" orientation="0" color="200,0,0"/>

        <!-- Second layer (z=1) partial fill -->
        <block position="2,2,1" orientation="0" color="0,200,0"/>
        <block position="3,2,1" orientation="0" color="0,200,0"/>
        <block position="4,2,1" orientation="0" color="0,200,0"/>
        <block position="5,2,1" orientation="0" color="0,200,0"/>
        <block position="6,2,1" orientation="0" color="0,200,0"/>
        <block position="7,2,1" orientation="0" color="0,200,0"/>
        <block position="2,3,1" orientation="0" color="0,200,0"/>
        <block position="3,3,1" orientation="0" color="0,200,0"/>
        <block position="4,3,1" orientation="0" color="0,200,0"/>
        <block position="5,3,1" orientation="0" color="0,200,0"/>
        <block position="6,3,1" orientation="0" color="0,200,0"/>
        <block position="7,3,1" orientation="0" color="0,200,0"/>
        <block position="2,4,1" orientation="0" color="0,200,0"/>
        <block position="3,4,1" orientation="0" color="0,200,0"/>
        <block position="4,4,1" orientation="0" color="0,200,0"/>
        <block position="5,4,1" orientation="0" color="0,200,0"/>
    </blockList>

    <!-- Target: 6x4x2 rectangular block filling z=0 and z=1 at positions 2-7, 2-5 -->
    <targetList>
        <target format="grid">
            <!-- z=0 layer -->
            <cell position="2,2,0"/>  <cell position="3,2,0"/>
            <cell position="4,2,0"/>  <cell position="5,2,0"/>
            <cell position="6,2,0"/>  <cell position="7,2,0"/>
            <cell position="2,3,0"/>  <cell position="3,3,0"/>
            <cell position="4,3,0"/>  <cell position="5,3,0"/>
            <cell position="6,3,0"/>  <cell position="7,3,0"/>
            <cell position="2,4,0"/>  <cell position="3,4,0"/>
            <cell position="4,4,0"/>  <cell position="5,4,0"/>
            <cell position="6,4,0"/>  <cell position="7,4,0"/>
            <cell position="2,5,0"/>  <cell position="3,5,0"/>
            <cell position="4,5,0"/>  <cell position="5,5,0"/>
            <cell position="6,5,0"/>  <cell position="7,5,0"/>
            <!-- z=1 layer -->
            <cell position="2,2,1"/>  <cell position="3,2,1"/>
            <cell position="4,2,1"/>  <cell position="5,2,1"/>
            <cell position="6,2,1"/>  <cell position="7,2,1"/>
            <cell position="2,3,1"/>  <cell position="3,3,1"/>
            <cell position="4,3,1"/>  <cell position="5,3,1"/>
            <cell position="6,3,1"/>  <cell position="7,3,1"/>
            <cell position="2,4,1"/>  <cell position="3,4,1"/>
            <cell position="4,4,1"/>  <cell position="5,4,1"/>
            <cell position="6,4,1"/>  <cell position="7,4,1"/>
            <cell position="2,5,1"/>  <cell position="3,5,1"/>
            <cell position="4,5,1"/>  <cell position="5,5,1"/>
            <cell position="6,5,1"/>  <cell position="7,5,1"/>
        </target>
    </targetList>
</world>
