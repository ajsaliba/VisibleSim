<?xml version="1.0" standalone="no" ?>
<!-- Config 2: "Fill the Row"
     A 4x3 base (in target) with 4 supply modules extending left as an arm.
     Target: 4x4 rectangle. Supply must traverse the surface to fill row y=5. -->
<world gridSize="10,10,3" windowSize="1280,720">
    <camera target="30,30,5" directionSpherical="-30,40,100" angle="45.0" near="1.0" far="600.0"/>

    <blockList color="128,128,128" blockSize="10,10,10">
        <!-- Core: 4x3 base at z=0 (x=3-6, y=2-4) — already in target -->
        <block position="3,2,0" orientation="0" color="0,200,0"/>
        <block position="4,2,0" orientation="0" color="0,200,0"/>
        <block position="5,2,0" orientation="0" color="0,200,0"/>
        <block position="6,2,0" orientation="0" color="0,200,0"/>
        <block position="3,3,0" orientation="0" color="0,200,0"/>
        <block position="4,3,0" orientation="0" color="0,200,0"/>
        <block position="5,3,0" orientation="0" color="0,200,0"/>
        <block position="6,3,0" orientation="0" color="0,200,0"/>
        <block position="3,4,0" orientation="0" color="0,200,0"/>
        <block position="4,4,0" orientation="0" color="0,200,0"/>
        <block position="5,4,0" orientation="0" color="0,200,0"/>
        <block position="6,4,0" orientation="0" color="0,200,0"/>

        <!-- Supply arm: 4 modules extending left (not in target) -->
        <block position="2,3,0" orientation="0" color="200,0,0"/>
        <block position="2,4,0" orientation="0" color="200,0,0"/>
        <block position="1,3,0" orientation="0" color="200,0,0"/>
        <block position="1,4,0" orientation="0" color="200,0,0"/>
    </blockList>

    <!-- Target: 4x4 rectangle at z=0 (x=3-6, y=2-5) -->
    <targetList>
        <target format="grid">
            <cell position="3,2,0"/>  <cell position="4,2,0"/>
            <cell position="5,2,0"/>  <cell position="6,2,0"/>
            <cell position="3,3,0"/>  <cell position="4,3,0"/>
            <cell position="5,3,0"/>  <cell position="6,3,0"/>
            <cell position="3,4,0"/>  <cell position="4,4,0"/>
            <cell position="5,4,0"/>  <cell position="6,4,0"/>
            <cell position="3,5,0"/>  <cell position="4,5,0"/>
            <cell position="5,5,0"/>  <cell position="6,5,0"/>
        </target>
    </targetList>
</world>
